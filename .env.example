# HerbTrace Environment Configuration
PORT=3000
NODE_ENV=development
# Set to the public HTTPS app URL when generating QR codes for deployment.
PUBLIC_APP_URL=

# Database Configuration (Optional: Connects to MongoDB when available; otherwise uses resilient persistent local store)
MONGO_URI=mongodb://localhost:27017/herbtrace

# Authentication Secrets
JWT_SECRET=replace-with-a-long-random-secret

# Email Verification (SMTP configuration; when not provided, demo verification URLs are output in console and UI)
EMAIL_HOST=smtp.ethereal.email
EMAIL_PORT=587
EMAIL_USER=demo_user@ethereal.email
EMAIL_PASS=demo_password
EMAIL_FROM="HerbTrace Quality Dept <no-reply@herbtrace.demo>"

# Storage (Cloudinary; falls back to local /uploads/ directory)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Blockchain Network (Hardhat / Ethereum RPC; falls back to internal cryptographic ledger)
BLOCKCHAIN_RPC_URL=http://127.0.0.1:8545
CONTRACT_ADDRESS=
PRIVATE_KEY=
